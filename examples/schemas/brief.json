{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "facts", "unknowns"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "facts": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "maxLength": 500}},
    "unknowns": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "maxLength": 500}}
  }
}
