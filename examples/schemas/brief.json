{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "facts", "unknowns", "claims"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "claims": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/claim"}},
    "facts": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "maxLength": 500}},
    "unknowns": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "maxLength": 500}}
  },
  "$defs": {"claim": {"type": "object", "additionalProperties": false,
    "required": ["text", "source_id", "quote"], "properties": {
      "text": {"type": "string", "minLength": 1, "maxLength": 500},
      "source_id": {"type": "string", "pattern": "^S[0-9]+$"},
      "quote": {"type": "string", "minLength": 8, "maxLength": 500}
    }}}
}
