{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["recommendation", "rationale", "conditions", "citations", "claims", "calculations"],
  "additionalProperties": false,
  "properties": {
    "claims": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/claim"}},
    "calculations": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false,
      "required": ["source_id", "metric", "numerator", "denominator", "percentage"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^S[0-9]+$"},
        "metric": {"enum": ["timeout_rate", "client_visible_failure_rate", "checklist_completeness", "dashboard_explicit_error_rate"]},
        "numerator": {"type": "number", "minimum": 0}, "denominator": {"type": "number", "exclusiveMinimum": 0},
        "percentage": {"type": "number", "minimum": 0, "maximum": 100}
      }}},
    "recommendation": {"enum": ["broad_launch", "restricted_pilot", "hold"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 1800},
    "conditions": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "maxLength": 500, "pattern": "^Proposed:"}},
    "citations": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "pattern": "^S[0-9]+$"}}
  },
  "$defs": {"claim": {"type": "object", "additionalProperties": false,
    "required": ["text", "source_id", "quote"], "properties": {
      "text": {"type": "string", "minLength": 1, "maxLength": 500},
      "source_id": {"type": "string", "pattern": "^S[0-9]+$"},
      "quote": {"type": "string", "minLength": 8, "maxLength": 500}
    }}}
}
